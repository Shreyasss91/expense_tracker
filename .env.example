# Placeholders only — copy to .env.local and fill with real values.
# Never commit real secrets.

DATABASE_URL="postgresql://..."
AUTH_SECRET="..."
NEXTAUTH_URL="http://localhost:3000"
FAMILY_MASTER_PASSWORD="..."

# §2.9 Receipts — object storage. Without this the Attach button reports
# "not configured" instead of silently dropping photos.
BLOB_READ_WRITE_TOKEN="..."

# §2.10 Monthly backup delivery (/api/cron/backup, 1st at 04:00 IST).
# At least one channel must be configured or the cron fails loudly with 503 —
# a backup job that silently does nothing is worse than one that errors.
# Telegram: sendDocument with the canonical 7-column CSV of the month.
TELEGRAM_BOT_TOKEN="..."
TELEGRAM_CHAT_ID="..."
# Email: Resend REST API (one fetch, no extra dependency).
RESEND_API_KEY="..."
BACKUP_EMAIL_TO="family@example.com"
BACKUP_EMAIL_FROM="ledger@example.com"
