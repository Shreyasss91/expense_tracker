# Placeholders only — copy to .env.local and fill with real values.
# Never commit real secrets.

DATABASE_URL="postgresql://..."
AUTH_SECRET="..."
NEXTAUTH_URL="http://localhost:3000"
FAMILY_MASTER_PASSWORD="..."

# §2.9 Receipts — object storage. Without this the Attach button reports
# "not configured" instead of silently dropping photos.
BLOB_READ_WRITE_TOKEN="..."

# §2.10 Monthly backup delivery (/api/cron/backup, 1st at 04:00 IST).
# At least one channel must be configured or the cron fails loudly with 503 —
# a backup job that silently does nothing is worse than one that errors.
# Telegram: sendDocument with the canonical 7-column CSV of the month.
# The SAME vars also drive the automatic weekly/monthly digest on Telegram
# (/api/cron/digest, 7th/14th/21st/28th + month-end at 10 PM IST).
TELEGRAM_BOT_TOKEN="..."
TELEGRAM_CHAT_ID="..."
# Email: Resend REST API (one fetch, no extra dependency).
RESEND_API_KEY="..."
BACKUP_EMAIL_TO="family@example.com"
BACKUP_EMAIL_FROM="ledger@example.com"

# §2.11 Web Push (VAPID). Generate with `node scripts/generate-vapid.mjs`.
# Without these, the Notifications toggle in Settings reports "not configured"
# instead of silently failing. PUBLIC_KEY ships to the browser for
# pushManager.subscribe(); PRIVATE_KEY and SUBJECT stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----"
VAPID_SUBJECT="mailto:family@example.com"

# Shared by every /api/cron/* route (digest, recurring, backup, push).
CRON_SECRET="..."

# Daily ledger-change feed -> a private WhatsApp group, posted by a small sender
# agent running in Termux on a phone (see docs/plans/whatsapp-agent-termux.md).
# Guards GET/POST /api/digest/day. When absent that route answers 503 and the
# agent fails loudly instead of silently posting nothing.
# Generate a value with: openssl rand -hex 32
DIGEST_AGENT_TOKEN="..."
# The SENDING phone's number — E.164 DIGITS ONLY, no "+", no spaces. Read ONLY by
# `npm run init:whatsapp-agent-config` on the laptop, which writes
# tools/whatsapp-agent/config.json for pushing to the phone (the agent validates
# it again, and refuses to repair a mangled number silently). The SERVER reads it
# nowhere, so it does NOT belong on Vercel — no route needs the sender's number.
# A generic `PHONE_NUMBER` is also accepted, with a rename warning.
DIGEST_AGENT_PHONE="919876543210"

# NOTE: the weekly/monthly WhatsApp digest needs NO env vars — it uses
# Click-to-Chat: the recipient number + enable toggle live in Settings
# (app_settings), and "sending" opens wa.me with the digest pre-filled for one
# manual Send tap. Telegram's delivery of that digest DOES use the TELEGRAM_*
# vars above.
