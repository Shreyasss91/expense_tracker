{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/digest",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/cron/recurring",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "0 4 1 * *"
    },
    {
      "path": "/api/cron/push",
      "schedule": "0 9 * * *"
    }
  ]
}
