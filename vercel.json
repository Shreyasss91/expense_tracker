{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/digest",
      "schedule": "30 16 * * *"
    },
    {
      "comment": "22:15 IST — the daily ledger feed's fallback: pings only when no post is recorded (16:45 UTC)",
      "path": "/api/cron/digest-fallback",
      "schedule": "45 16 * * *"
    },
    {
      "path": "/api/cron/recurring",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "0 4 1 * *"
    },
    {
      "path": "/api/cron/push",
      "schedule": "0 9 * * *"
    }
  ]
}
