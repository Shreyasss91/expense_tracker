# Baileys declares `sharp` as a peer dependency, and sharp is NOT marked optional
# in its peerDependenciesMeta. A plain `npm install` therefore pulls the entire
# sharp platform matrix (@img/sharp-linux-arm64, @img/sharp-win32-x64, …), which
# is a native module — exactly the class of dependency that breaks an install on
# Termux/Android.
#
# This agent sends PLAIN TEXT only, so sharp is never imported at runtime. The
# peer dependencies are image/sticker/audio/link-preview helpers:
#   jimp, sharp        → thumbnails
#   audio-decode       → voice-note transcription
#   link-preview-js    → URL previews
#
# `legacy-peer-deps` makes npm ignore peerDependencies entirely while resolving.
# Verified against the registry: with it the tree is 84 packages and contains no
# sharp at all; without it, the whole sharp matrix is installed.
#
# Keep this file. Removing it turns `npm install` into a native build failure on
# the phone, and that failure looks like a Baileys problem rather than a config one.
legacy-peer-deps=true

# Optional dependencies are not needed either, and omitting them removes another
# chance of a platform-specific binary being pulled in.
omit=optional
